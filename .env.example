# Server-only. Do not prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs homeowner confirmation tokens. Generate with: openssl rand -base64 32
LEAD_ACCESS_SECRET=

# Transactional email
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=Quotramax Inspections <inspections@quotramax.com>
CONTRACTOR_EMAIL=contractor@example.com

# Optional extra inbox for contractor alerts (BCC)
LEAD_ALERT_BCC=
